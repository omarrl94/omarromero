rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // El superadmin solo cuenta con el correo VERIFICADO (con Google ya lo está).
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'omar.romero@jrotero.es';
    }
    match /users/{uid} {
      // Cada usuario lee y escribe solo su documento
      allow read, write: if request.auth != null && request.auth.uid == uid;
      // El superadmin puede leer todos (panel de usuarios)
      allow read: if isAdmin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
