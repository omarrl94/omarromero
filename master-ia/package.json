{
  "name": "master-ia-jro",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "Plataforma del Máster en IA Aplicada al Desarrollo de Aplicaciones Multiplataforma — CFP José Ramón Otero (Firebase)",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:demo": "MODO=demo node scripts/build.mjs",
    "build:emuladores": "FIREBASE_EMULADORES=1 node scripts/build.mjs",
    "emuladores": "firebase emulators:start --project demo-master-ia",
    "test:reglas": "firebase emulators:exec --only firestore --project demo-master-ia \"node --test tests/reglas.test.mjs\"",
    "deploy": "REQUIERE_FIREBASE=1 node scripts/build.mjs && firebase deploy --only hosting,firestore:rules,firestore:indexes"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "esbuild": "0.28.2",
    "firebase-tools": "15.34.2",
    "tailwindcss": "3.4.17"
  },
  "dependencies": {
    "firebase": "13.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
