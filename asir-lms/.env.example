# ─────────────────────────────────────────────────────────────
# Base de datos: Supabase (PostgreSQL)
# En Supabase: Project Settings → Database → Connection string
#
# DATABASE_URL  → cadena del POOLER (Transaction, puerto 6543) para la app
# DIRECT_URL    → conexión DIRECTA (puerto 5432) para migraciones / db push
# Sustituye [PASSWORD] por la contraseña de tu base de datos y [REF] por
# la referencia de tu proyecto.
# ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# NextAuth — genera un secreto con: openssl rand -base64 32
NEXTAUTH_SECRET="cambia-este-secreto"
# En local: http://localhost:3000 · En Netlify: la URL pública del sitio
NEXTAUTH_URL="http://localhost:3000"

# Contraseñas iniciales de las cuentas que crea el seed (no se suben al repositorio)
SEED_ADMIN_PASSWORD=""
SEED_SUPERIOR_PASSWORD=""
SEED_MEDIO_PASSWORD="alumno123"
