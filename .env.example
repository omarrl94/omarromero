# ──────────────────────────────────────────────────────────────
# Rollo Madrid — variables de entorno
#
#   cp .env.example .env.local
#
# Las seis son PÚBLICAS por diseño: viajan al navegador dentro del
# bundle. Lo que protege los datos no es el secreto, sino la
# restricción por dominio (Google) y las reglas de Firestore.
#
# Nunca pongas aquí una clave de cuenta de servicio ni nada marcado
# como secreto: .env.local está ignorado por git, pero el bundle no.
# ──────────────────────────────────────────────────────────────

# ── Google Maps ───────────────────────────────────────────────
# console.cloud.google.com → el MISMO proyecto que Firebase:
#   1. APIs y servicios → Biblioteca → habilita
#        · Maps JavaScript API   (el mapa)
#        · Places API (New)      (el buscador de bares)
#   2. APIs y servicios → Credenciales → Crear credenciales → Clave de API
#   3. Restringe por sitio web: http://localhost:3000/* y tu dominio
#   4. Google Maps Platform → Gestión de mapas → Crear ID de mapa
#      (tipo JavaScript, vectorial): sin él no se pintan las chapas
#
# Si falta la clave, la app dibuja un mapa esquemático y lo dice.

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIza...tu-clave
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# ── Firebase ──────────────────────────────────────────────────
# console.firebase.google.com → tu proyecto:
#   1. Compilación → Authentication → Sign-in method → activa "Correo
#      electrónico/contraseña"
#   2. Compilación → Firestore Database → Crear base de datos
#      (modo producción; las reglas las trae este repositorio)
#   3. ⚙ Configuración del proyecto → Tus apps → Web (</>) → registra la
#      app y copia de firebaseConfig estos cuatro valores
#
# Si falta cualquiera, la app arranca en MODO LOCAL: cuentas con alias
# y datos guardados solo en ese navegador. Sirve para probar.

NEXT_PUBLIC_FIREBASE_API_KEY=AIza...clave-web
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abc123
