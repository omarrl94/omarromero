# Copia este archivo a .env (no se sube a Git) para desarrollo con `netlify dev`,
# o define las variables en Netlify → Project configuration → Environment variables.

# --- Firebase (web): públicas por diseño ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- Firebase (servidor): SECRETA. JSON completo de la cuenta de servicio de ESTE proyecto ---
FIREBASE_SERVICE_ACCOUNT=

# --- Correo del centro (igual que ColaboraFP y la web de exámenes) ---
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Alternativas: RESEND_API_KEY  ·  MS_TENANT_ID + MS_CLIENT_ID + MS_CLIENT_SECRET

# --- Opcionales ---
# APP_URL=https://conecta-ffe-jrotero.netlify.app
# SUPERADMIN_EMAILS=otra.persona@jrotero.es
# SESSION_SECRET=           (si falta, el servidor genera y guarda su propia clave)
# ADZUNA_APP_ID= / ADZUNA_APP_KEY=
# INFOJOBS_CLIENT_ID= / INFOJOBS_CLIENT_SECRET=

# --- Solo desarrollo y pruebas (se ignoran en Netlify) ---
# CONECTA_MODO=pruebas
# CONECTA_DATOS=ficticios
# VITE_AUTH=prueba
# MAIL_MODE=log
