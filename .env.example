# Copia este archivo a .env (no se sube a Git) para desarrollo local con `netlify dev`,
# o define las variables en Netlify → Project configuration → Environment variables.
# NINGUNA de estas variables debe empezar por VITE_: son solo del servidor.

# Código de acceso al directorio de empresas (se lo das al alumnado). Obligatorio.
ACCESS_CODE=
# Código de acceso para el profesorado tutor (sección «Tutores»: escribir a las empresas del ciclo). Opcional.
# Debe ser distinto de ACCESS_CODE.
TUTOR_ACCESS_CODE=
# Opcional. Secreto para firmar la cookie de sesión (32+ caracteres). Si falta o es corto, el servidor
# genera una clave aleatoria y la guarda en Netlify Blobs.
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Adzuna (https://developer.adzuna.com/) — opcional
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# InfoJobs (https://developer.infojobs.net/) — opcional
INFOJOBS_CLIENT_ID=
INFOJOBS_CLIENT_SECRET=

# Solo desarrollo/pruebas (se ignoran en Netlify):
# CONECTA_MODO=pruebas
# CONECTA_DATOS=ficticios
