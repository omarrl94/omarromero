# Configuración web de Firebase (Consola de Firebase → Configuración del proyecto → Tus apps → Web).
# Copia este archivo como .env.local y rellénalo. Sin estas variables la app funciona en «modo local».
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Desarrollo con los emuladores locales de Auth y Firestore (npm run emuladores).
# VITE_FIREBASE_EMULATORS=1

# Tutor con IA (opcional). En la web no hace falta: usa /api/duck del mismo sitio.
# Para la app de Android, la dirección completa de tu sitio de Netlify:
# VITE_DUCK_API_URL=https://TU-SITIO.netlify.app/api/duck
