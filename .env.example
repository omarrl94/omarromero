# Configuración web de Firebase: ⚙ Configuración del proyecto → Tus apps → Web.
# Copia este fichero a .env para compilar en local con Firebase. En Netlify se
# definen en Site configuration → Environment variables.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
FIREBASE_PROJECT_ID=tu-proyecto
FIREBASE_APP_ID=
# Opcionales
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
# 1 = usar los emuladores locales (npm run emuladores)
FIREBASE_EMULADOR=
