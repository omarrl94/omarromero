# Variables de entorno — se configuran en Netlify:
#   Site configuration → Environment variables
# (en local: copia a .env y usa `netlify dev`)

# ── Opción A: SMTP (Microsoft 365 del centro, Gmail…) ─────────
# Microsoft 365: smtp.office365.com, puerto 587. La cuenta necesita
# "SMTP autenticado" activado en el Centro de administración de M365.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=examenes@jrotero.es
SMTP_PASS=contraseña-o-contraseña-de-aplicación
MAIL_FROM="Exámenes FP José Ramón Otero <examenes@jrotero.es>"

# ── Opción B: Resend (API HTTP, sin SMTP) ─────────────────────
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM="Exámenes <examenes@jrotero.es>"   # dominio verificado en Resend

# ── Comunes ───────────────────────────────────────────────────
# Copia oculta de cada entrega al profesor (y dirección de respuesta).
PROFESOR_EMAIL=profesor@jrotero.es
# Solo se aceptan correos de estos dominios (separados por comas).
DOMINIOS_PERMITIDOS=jrotero.es
NOMBRE_CENTRO=FP José Ramón Otero
