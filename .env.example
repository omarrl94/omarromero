# ──────────────────────────────────────────────────────────────
# Rollo Madrid — variables de entorno
#
# Copia este archivo como .env.local y rellena tu clave:
#   cp .env.example .env.local
#
# 1. Entra en https://console.cloud.google.com/ y crea un proyecto.
# 2. APIs y servicios → Biblioteca → habilita:
#      · Maps JavaScript API   (el mapa)
#      · Places API (New)      (el buscador de bares)
# 3. APIs y servicios → Credenciales → Crear credenciales → Clave de API.
# 4. Restringe la clave por dominio (HTTP referrers): es pública, viaja
#    al navegador. Sin restricción, cualquiera puede gastar tu cuota.
# ──────────────────────────────────────────────────────────────

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIza...tu-clave

# ──────────────────────────────────────────────────────────────
# Map ID: obligatorio para los marcadores avanzados (los pines de
# colores). Se crea en Google Maps Platform → Gestión de mapas.
# DEMO_MAP_ID vale para desarrollo (sale una marca de agua).
# ──────────────────────────────────────────────────────────────

NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# ──────────────────────────────────────────────────────────────
# Cuentas (opcional): registro e inicio de sesión con Supabase.
#
# Sin estas dos variables la app arranca en MODO LOCAL: basta un
# alias y se guarda solo en el navegador. Sirve para probar, no
# para producción.
#
# 1. Crea un proyecto en https://supabase.com (el plan Free vale).
# 2. Project Settings → API.
# 3. Copia la "Project URL" y la "anon public" key (nunca la
#    service_role: esa es secreta y no debe salir del servidor).
# 4. En Authentication → Providers deja activado "Email".
# ──────────────────────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...tu-anon-key
