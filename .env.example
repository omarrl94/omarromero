# Copia este archivo a .env y ajusta los valores.
# Con docker compose (npm run db:up) esta URL funciona tal cual.
DATABASE_URL="postgresql://paws:paws@localhost:5432/pawsmatch?schema=public"

# Secreto para firmar la cookie de sesión (mínimo 32 caracteres).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
