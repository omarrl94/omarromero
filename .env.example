# Configuración web de Firebase: ⚙ Configuración del proyecto → Tus apps → Web.
# Copia este fichero a .env para compilar en local con Firebase. En Netlify se
# definen en Site configuration → Environment variables.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
FIREBASE_PROJECT_ID=tu-proyecto
FIREBASE_APP_ID=
# Opcionales
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
# 1 = usar los emuladores locales (npm run emuladores)
FIREBASE_EMULADOR=

# ── Correo del centro (función de Netlify; mismo sistema que ColaboraFP y Exámenes) ──
# En Netlify: Project configuration → Environment variables, ámbito «Functions».
# Opción A · SMTP (Microsoft 365 del centro): la cuenta necesita «SMTP autenticado».
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=omar.romero@jrotero.es
SMTP_PASS=contraseña-o-contraseña-de-aplicación
MAIL_FROM="Curso de Claude · FP José Ramón Otero <omar.romero@jrotero.es>"
# Opción B · Resend:  RESEND_API_KEY=re_xxx  y  MAIL_FROM con un dominio verificado en Resend
# Pruebas locales sin enviar nada: MAIL_MODE=log

# Cuenta de servicio de Firebase (⚙ Configuración del proyecto → Cuentas de servicio →
# Generar nueva clave privada). Pega el JSON completo. ES SECRETA: márcala como «secret».
FIREBASE_SERVICE_ACCOUNT=
# Profesorado que recibe los avisos de altas y copia de las entregas (separado por comas)
ADMIN_EMAILS=omar.romero@jrotero.es
# Dirección pública de la web para los enlaces de los correos (opcional)
# APP_URL=https://curso-claude-jrotero.netlify.app

# Contraseña inicial del profesor (como en la web de exámenes). Solo vale para el PRIMER
# acceso de ADMIN_EMAILS: la web obliga a cambiarla y después deja de funcionar.
# Ponla SOLO en Netlify, nunca en el código, y márcala como «secret».
ADMIN_PASSWORD=

# ── Campus Virtual (opcional) ──
# Con estas variables, quien entra desde el campus con el enlace firmado se registra sin
# correo @jrotero.es ni código de aula. CAMPUS_API_KEY es la misma clave que en el campus (secret).
CAMPUS_API_KEY=
CAMPUS_FORMACION=curso-claude
# Dirección del campus para el enlace del pie de página (se lee al compilar)
CAMPUS_URL=
