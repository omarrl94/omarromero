# Variables de entorno — se configuran en Netlify:
#   Site configuration → Environment variables
# (en local no hace falta nada: `npm test` usa valores de prueba)

# ── Profesorado (OBLIGATORIO) ─────────────────────────────────
# Correos con acceso al panel del profesor (/profesor/), separados por comas.
ADMIN_EMAILS=omar.romero@jrotero.es
# Contraseña del profesor. Con ella se entra directamente (la cuenta se crea
# sola la primera vez, sin registrarse ni código). Ponla SOLO en Netlify,
# nunca en el código. Márcala como «secret».
ADMIN_PASSWORD=tu-contraseña

# Dominios con los que se pueden registrar los alumnos.
DOMINIOS_PERMITIDOS=jrotero.es

# ── Correo · Opción A: SMTP (Microsoft 365 del centro, Gmail…) ─
# Microsoft 365: smtp.office365.com, puerto 587. La cuenta necesita
# «SMTP autenticado» activado en el Centro de administración de M365.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=omar.romero@jrotero.es
SMTP_PASS=contraseña-o-contraseña-de-aplicación
MAIL_FROM="Exámenes FP José Ramón Otero <omar.romero@jrotero.es>"

# ── Correo · Opción B: Resend (API HTTP, sin SMTP) ────────────
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM="Exámenes <examenes@jrotero.es>"   # dominio verificado en Resend

# ── IA: generar exámenes a partir de diapositivas o PDF ────────
# Clave de la API de Anthropic (console.anthropic.com → API Keys).
# Márcala como «secret». Sin ella, el botón «Generar con IA» queda desactivado.
ANTHROPIC_API_KEY=sk-ant-...

# ── Opcionales ────────────────────────────────────────────────
# Copia oculta de cada entrega (y dirección de respuesta de los correos).
PROFESOR_EMAIL=omar.romero@jrotero.es
NOMBRE_CENTRO=FP José Ramón Otero
# Secreto para firmar las sesiones. Si no se pone, se genera uno solo
# la primera vez y se guarda en Netlify Blobs.
# SESSION_SECRET=una-cadena-larga-y-aleatoria
