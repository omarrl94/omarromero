# Configuración web de Firebase del PROYECTO DEL CAMPUS (no reutilices el del curso ni el del máster).
# ⚙ Configuración del proyecto → Tus apps → Web. En Netlify van en Environment variables.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=campus-jrotero.firebaseapp.com
FIREBASE_PROJECT_ID=campus-jrotero
FIREBASE_APP_ID=
# 1 = usar los emuladores locales (npm run emuladores)
FIREBASE_EMULADOR=

# ── Funciones de Netlify (ámbito «Functions»; márcalas como «secret») ──
# Cuenta de servicio: ⚙ Configuración del proyecto → Cuentas de servicio → Generar nueva clave privada.
FIREBASE_SERVICE_ACCOUNT=
# Stripe → Developers → API keys. Sin ella el campus muestra «Solicitar matrícula» en vez de «Comprar».
STRIPE_SECRET_KEY=sk_test_xxx
# Stripe → Developers → Webhooks → endpoint …/.netlify/functions/stripe-webhook → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Clave que comparten el campus y las plataformas de cada formación para consultar accesos
# (genera una larga y aleatoria: openssl rand -hex 32)
CAMPUS_API_KEY=
# Dirección pública del campus (para volver de la pasarela de pago). Por defecto, la de Netlify.
# APP_URL=https://campus.jrotero.es
# Formaciones que se matriculan con código de admisión propio (el máster). El campus crea el código en
# el Firestore de la plataforma con su misma cuenta de servicio (rol IAM en ese proyecto; INTEGRACION.md).
# PLATAFORMAS_CODIGO={"master-ia-dam":{"proyecto":"master-ia-jrotero","prefijo":"MIA"}}
