{
  "name": "curso-claude-jrotero",
  "version": "1.0.0",
  "private": true,
  "description": "LMS del curso Especialización en Ingeniería de IA, Skills, MCP y Automatización con Claude · FP José Ramón Otero",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/servir.mjs",
    "dev:demo": "node scripts/build.mjs --demo && node scripts/servir.mjs",
    "emuladores": "firebase emulators:start --only auth,firestore --project demo-jrotero",
    "probar:reglas": "firebase emulators:exec --only firestore --project demo-jrotero \"node scripts/probar-reglas.mjs\"",
    "desplegar:firebase": "firebase deploy --only hosting,firestore",
    "desplegar:reglas": "firebase deploy --only firestore"
  },
  "dependencies": {
    "firebase": "13.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "esbuild": "0.28.2",
    "firebase-tools": "15.34.1",
    "tailwindcss": "3.4.16"
  },
  "engines": {
    "node": ">=20"
  }
}
