{
  "name": "cyberops-academia",
  "version": "1.0.0",
  "private": true,
  "description": "CyberOps: Operación Fénix — aprende ciberseguridad desde cero hasta nivel avanzado jugando en un laboratorio simulado: OSINT, escaneo, enumeración, web, criptografía, explotación, escalada y Blue Team.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node scripts/verify-campaign.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-cyberops \"node scripts/test-firestore-rules.mjs\"",
    "emuladores": "firebase emulators:start --only auth,firestore --project demo-cyberops",
    "dev:emuladores": "VITE_FIREBASE_EMULATORS=1 VITE_FIREBASE_API_KEY=demo-key VITE_FIREBASE_PROJECT_ID=demo-cyberops VITE_FIREBASE_AUTH_DOMAIN=demo-cyberops.firebaseapp.com VITE_FIREBASE_APP_ID=demo vite",
    "desplegar:reglas": "firebase deploy --only firestore",
    "desplegar:hosting": "npm run build && firebase deploy --only hosting",
    "preview:html": "node scripts/build-preview.mjs"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.1.1",
    "firebase": "11.10.0",
    "framer-motion": "11.11.17",
    "lucide-react": "0.460.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "4.0.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "firebase-tools": "13.35.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.16",
    "vite": "5.4.21"
  },
  "engines": {
    "node": ">=18"
  }
}
