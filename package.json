{
  "name": "codeforge-bitlandia",
  "version": "1.0.0",
  "private": true,
  "description": "CodeForge II: Bitlandia — un RPG de criaturas donde aprendes a programar depurando bugs en 10 lenguajes.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node scripts/verify-curriculum.mjs && node scripts/verify-world.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-codeforge \"node scripts/test-firestore-rules.mjs\"",
    "emuladores": "firebase emulators:start --only auth,firestore --project demo-codeforge",
    "dev:emuladores": "VITE_FIREBASE_EMULATORS=1 VITE_FIREBASE_API_KEY=demo-key VITE_FIREBASE_PROJECT_ID=demo-codeforge VITE_FIREBASE_AUTH_DOMAIN=demo-codeforge.firebaseapp.com VITE_FIREBASE_APP_ID=demo vite",
    "desplegar:reglas": "firebase deploy --only firestore",
    "desplegar:hosting": "npm run build && firebase deploy --only hosting",
    "test:world": "node scripts/verify-world.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@fontsource/jetbrains-mono": "5.1.1",
    "@fontsource/pixelify-sans": "5.1.1",
    "firebase": "11.10.0",
    "framer-motion": "11.11.17",
    "lucide-react": "0.460.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@firebase/rules-unit-testing": "4.0.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "firebase-tools": "13.35.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.16",
    "vite": "5.4.21"
  },
  "engines": {
    "node": ">=18"
  }
}
