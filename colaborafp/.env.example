# ColaboraFP — Variables de entorno (copia a .env.local o defínelas en Netlify)
# Sin VITE_FIREBASE_CONFIG la app funciona en MODO DEMO (datos solo en este navegador).

# Configuración web de Firebase, tal cual la muestra la consola (en una línea):
VITE_FIREBASE_CONFIG=

# Dominio(s) del correo del profesorado. ⚠ Debe coincidir con firebase/firestore.rules (isTeacher).
VITE_TEACHER_EMAIL_DOMAINS=jrotero.es

# Datos del titular para el aviso legal y la política de privacidad (LSSI art. 10 / RGPD art. 13)
VITE_CENTRO_NOMBRE=Centro de Formación Profesional José Ramón Otero
VITE_CENTRO_TITULAR=
VITE_CENTRO_NIF=
VITE_CENTRO_DIRECCION=
VITE_CENTRO_EMAIL=
VITE_CENTRO_TELEFONO=
VITE_CENTRO_REGISTRO=
VITE_CENTRO_DPD=
VITE_CENTRO_WEB=
