# ColaboraFP — Variables de entorno (copia a .env.local o defínelas en Netlify)
# Sin VITE_FIREBASE_CONFIG la app funciona en MODO DEMO (datos solo en este navegador).

# Configuración web de Firebase, tal cual la muestra la consola (en una línea):
VITE_FIREBASE_CONFIG=

# Dominio(s) del correo del profesorado. ⚠ Debe coincidir con firebase/firestore.rules (isTeacher).
VITE_TEACHER_EMAIL_DOMAINS=jrotero.es

# Datos del titular para el aviso legal y la política de privacidad (LSSI art. 10 / RGPD art. 13)
VITE_CENTRO_NOMBRE=Centro de Formación Profesional José Ramón Otero
VITE_CENTRO_TITULAR=
VITE_CENTRO_NIF=
VITE_CENTRO_DIRECCION=
VITE_CENTRO_EMAIL=
VITE_CENTRO_TELEFONO=
VITE_CENTRO_REGISTRO=
VITE_CENTRO_DPD=
VITE_CENTRO_WEB=

# ---------- Envío de correos (función de Netlify netlify/functions/correo.mjs) ----------
# Solo en Netlify (sin prefijo VITE_: nunca llegan al navegador). Si faltan, se usa el envío
# normal de Firebase (que el correo del centro bloquea). Mismo sistema que la web de exámenes.
#
# 1) Credenciales de Firebase: el archivo .json de «Cuentas de servicio», entero, en una línea
FIREBASE_SERVICE_ACCOUNT=
#    (o, si Netlify se queja del tamaño: FIREBASE_CLIENT_EMAIL y FIREBASE_PRIVATE_KEY)
#
# 2) Envío por SMTP del Microsoft 365 del centro (los mismos valores que la web de exámenes)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ColaboraFP · FP José Ramón Otero <buzon@jrotero.es>"
#    Alternativas: RESEND_API_KEY, o Microsoft Graph (MS_TENANT_ID, MS_CLIENT_ID, MS_CLIENT_SECRET)
#
# 3) Opcional: dirección de la web (por defecto, la de la propia petición)
APP_URL=https://colaborafp.netlify.app
